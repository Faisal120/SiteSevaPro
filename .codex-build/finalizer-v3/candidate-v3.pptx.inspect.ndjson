{"kind":"textbox","id":"sh/ne1s3alw","slideIndex":17,"position":{"left":22,"top":188,"width":438,"height":269.08},"name":"English dialogue","text":"Piku happily flies around the garden. While flying, she accidentally knocks over the plant. The broken/fallen plant is shown on stage.","geometry":"rect","lineWidth":0,"style":{"fontSize":26.67,"typeface":"Arial","color":"#16211D","bold":true,"alignment":"left"}}
