# Copy to /etc/siteseva/backend.env on the VPS and replace every placeholder.
APP_ENV=production
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sitesevapro_prod
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
SUPER_ADMIN_PHONE=+919876543210
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=OPTIONAL_GEMINI_KEY_FOR_FLOOR_PLANNER
CORS_ORIGINS=https://sitesevapro.in,https://www.sitesevapro.in
FRONTEND_URL=https://sitesevapro.in
GOOGLE_APPLICATION_CREDENTIALS=/etc/siteseva/firebase-service-account.json
PASSWORD_RESET_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
AUTH_CHALLENGE_SECRET=GENERATE_A_THIRD_LONG_RANDOM_SECRET
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
WHATSAPP_ACCESS_TOKEN=PERMANENT_META_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
WHATSAPP_API_VERSION=v27.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_CREDENTIALS_TEMPLATE=siteseva_account_credentials
WHATSAPP_PASSWORD_RESET_TEMPLATE=siteseva_password_reset
WHATSAPP_APPROVAL_TEMPLATE=siteseva_approval_update
WHATSAPP_ACCOUNT_APPROVED_TEMPLATE=siteseva_account_approved
# Use the exact language codes shown for the approved Meta templates.
WHATSAPP_ACCOUNT_APPROVED_TEMPLATE_LANGUAGE=en
WHATSAPP_ACTIVATION_TEMPLATE_LANGUAGE=en
WHATSAPP_PASSWORD_RESET_TEMPLATE_LANGUAGE=en
WHATSAPP_APPROVAL_TEMPLATE_LANGUAGE=en
WHATSAPP_AUTH_OTP_BUTTON_INDEX=0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=GENERATE_A_RANDOM_WEBHOOK_TOKEN
WHATSAPP_APP_SECRET=YOUR_META_APP_SECRET
UPI_ID=YOUR_BUSINESS_UPI_ID
UPI_PAYEE_NAME=YOUR_REGISTERED_BUSINESS_NAME
FREE_TRIAL_DAYS=30
FREE_MAX_SITES=1
FREE_MAX_SUPERVISORS=2
FREE_STORAGE_GB=2
FREE_MONTHLY_DESIGN_CREDITS=25
PREMIUM_MONTHLY_PRICE=2999
PREMIUM_MONTHLY_DESIGN_CREDITS=250
PREMIUM_STORAGE_GB=20
ENTERPRISE_MONTHLY_PRICE=4999
ENTERPRISE_MONTHLY_DESIGN_CREDITS=1000
ENTERPRISE_STORAGE_GB=100
RATE_LIMIT_REDIS_URL=
